<body>
  <main class="container">
    <h1>업무 FAQ 검색</h1>

    <!-- 검색 영역 -->
    <section class="search-area">
      <input
        type="search"
        id="searchInput"
        placeholder="질문이나 키워드를 입력하세요."
        aria-label="FAQ 검색"
      />
      <button id="showAllButton" type="button">전체보기</button>
    </section>

    <!-- 분류 영역 -->
    <section class="filter-section">
      <div class="filter-title">분류</div>

      <div class="category-buttons">
        <button
          type="button"
          class="category-button active"
          data-category="전체"
        >
          전체
        </button>

        <button
          type="button"
          class="category-button"
          data-category="추첨일시"
        >
          추첨일시
        </button>

        <button
          type="button"
          class="category-button"
          data-category="당첨자 발표"
        >
          당첨자 발표
        </button>

        <button
          type="button"
          class="category-button"
          data-category="참여방법"
        >
          참여방법
        </button>
      </div>
    </section>

    <!-- 검색 결과 -->
    <section>
      <div class="result-header">
        <h2>검색 결과</h2>
        <div id="resultCount"></div>
      </div>

      <div id="faqList" class="faq-list"></div>
    </section>
  </main>

  <script>
    // 제공된 FAQ 데이터만 사용합니다.
    const faqData = [
      {
        category: "추첨일시",
        question: "추첨은 언제 하나요?",
        answer_seed: "추첨은 8/25 9시에 합니다."
      },
      {
        category: "당첨자 발표",
        question: "당첨자 발표는 어떻게 하나요?",
        answer_seed: "당첨자는 홈페이지 첫 화면에 게시할 예정입니다."
      },
      {
        category: "참여방법",
        question: "추첨에 참여하려면 어떻게 하나요?",
        answer_seed: "홈페이지 상단 참여방법 탭을 참고하여 주시기 바랍니다."
      }
    ];

    const searchInput = document.getElementById("searchInput");
    const faqList = document.getElementById("faqList");
    const resultCount = document.getElementById("resultCount");
    const showAllButton = document.getElementById("showAllButton");
    const categoryButtons = document.querySelectorAll(".category-button");

    let selectedCategory = "전체";

    // HTML 특수문자를 안전하게 변환
    function escapeHTML(text) {
      return String(text)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    // 정규식 특수문자 처리
    function escapeRegExp(text) {
      return text.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    }

    // 검색어 강조
    function highlightText(text, keyword) {
      const safeText = escapeHTML(text);

      if (!keyword.trim()) {
        return safeText;
      }

      const safeKeyword = escapeRegExp(escapeHTML(keyword.trim()));
      const regex = new RegExp(`(${safeKeyword})`, "gi");

      return safeText.replace(regex, "<mark>$1</mark>");
    }

    // FAQ 검색 및 필터링
    function getFilteredFaqs() {
      const keyword = searchInput.value.trim().toLowerCase();

      return faqData.filter((faq) => {
        const matchesCategory =
          selectedCategory === "전체" ||
          faq.category === selectedCategory;

        const searchableText = [
          faq.question,
          faq.answer_seed,
          faq.category
        ]
          .join(" ")
          .toLowerCase();

        const matchesKeyword =
          keyword === "" || searchableText.includes(keyword);

        return matchesCategory && matchesKeyword;
      });
    }

    // 화면 출력
    function renderFaqs() {
      const filteredFaqs = getFilteredFaqs();
      const keyword = searchInput.value.trim();

      resultCount.textContent = `${filteredFaqs.length}건`;

      if (filteredFaqs.length === 0) {
        faqList.innerHTML = `
          <div class="empty-message">
            검색 결과가 없습니다.
          </div>
        `;
        return;
      }

      faqList.innerHTML = filteredFaqs
        .map((faq) => {
          return `
            <article class="faq-card">
              <div class="faq-category">
                ${highlightText(faq.category, keyword)}
              </div>

              <div class="faq-question">
                ${highlightText(faq.question, keyword)}
              </div>

              <div class="faq-answer">
                ${highlightText(faq.answer_seed, keyword)}
              </div>
            </article>
          `;
        })
        .join("");
    }

    // 키워드 검색
    searchInput.addEventListener("input", renderFaqs);

    // 카테고리 필터
    categoryButtons.forEach((button) => {
      button.addEventListener("click", () => {
        selectedCategory = button.dataset.category;

        categoryButtons.forEach((item) => {
          item.classList.remove("active");
        });

        button.classList.add("active");

        renderFaqs();
      });
    });

    // 전체보기
    showAllButton.addEventListener("click", () => {
      searchInput.value = "";
      selectedCategory = "전체";

      categoryButtons.forEach((button) => {
        button.classList.toggle(
          "active",
          button.dataset.category === "전체"
        );
      });

      renderFaqs();
      searchInput.focus();
    });

    // 최초 화면에 전체 FAQ 표시
    renderFaqs();
  </script>
</body>
</html>
